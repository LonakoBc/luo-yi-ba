[Unit]
Description=Luo Yi Ba multiplayer server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=luoyiba
Group=luoyiba
WorkingDirectory=/opt/luo-yi-ba-multiplayer/server
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
ExecStart=/usr/local/bin/node /opt/luo-yi-ba-multiplayer/server/src/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/luo-yi-ba-multiplayer/server/data

[Install]
WantedBy=multi-user.target
