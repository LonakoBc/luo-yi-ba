{
  "name": "luo-yi-ba-song-crawler",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "crawl": "node scripts/crawl.mjs",
    "crawl:yuezhengling": "node scripts/crawl.mjs --singer yuezhengling",
    "crawl:yanhe": "node scripts/crawl.mjs --singer yanhe",
    "crawl:longya": "node scripts/crawl.mjs --singer longya",
    "crawl:zhiyu-moke": "node scripts/crawl.mjs --singer zhiyu-moke",
    "crawl:moqingxian": "node scripts/crawl.mjs --singer moqingxian",
    "crawl:xinhua": "node scripts/crawl.mjs --singer xinhua",
    "crawl:xingchen": "node scripts/crawl.mjs --singer xingchen",
    "crawl:haiyi": "node scripts/crawl.mjs --singer haiyi --interval=1",
    "crawl:cangqiong": "node scripts/crawl.mjs --singer cangqiong --interval=1",
    "crawl:chiyu": "node scripts/crawl.mjs --singer chiyu --interval=1",
    "crawl:shian": "node scripts/crawl.mjs --singer shian --interval=1",
    "crawl:muxin": "node scripts/crawl.mjs --singer muxin --interval=1",
    "crawl:minus": "node scripts/crawl.mjs --singer minus --interval=1",
    "rebuild:songs": "node scripts/build-song-markdown.mjs",
    "rebuild:presets": "node scripts/build-library-presets.mjs",
    "images:refresh": "node scripts/refresh-song-images.mjs",
    "images:download": "node scripts/download-song-covers.mjs",
    "images:download-characters": "node scripts/download-character-images.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "cheerio": "1.1.2",
    "pinyin-pro": "3.27.0"
  }
}
